<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AxTools.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AxTools.Views"
    Title="Ax工具箱">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            x:Name="AppTitleBar"
            Padding="18,0,170,0"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="32"
                    Height="32"
                    CornerRadius="7"
                    VerticalAlignment="Center">
                    <Image
                        Source="ms-appx:///Assets/AxToolsIcon.png"
                        Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                    <TextBlock Text="Ax工具箱" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="AppVersionText" Style="{StaticResource SubtleTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <NavigationView
            x:Name="ShellNavigation"
            Grid.Row="1"
            CompactPaneLength="64"
            OpenPaneLength="286"
            PaneDisplayMode="LeftCompact"
            IsPaneOpen="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionFollowsFocus="Disabled"
            SelectionChanged="ShellNavigation_SelectionChanged">
            <NavigationView.Resources>
                <x:Double x:Key="NavigationViewItemOnLeftMinHeight">64</x:Double>
            </NavigationView.Resources>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="AxToolsNavItem" Content="Ax工具箱" Tag="AxTools">
                    <NavigationViewItem.Icon><ImageIcon Width="32" Height="32" Source="ms-appx:///Assets/Navigation/AxTools.png" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="FantasyToolsNavItem" Content="幻杀工具箱" Tag="FantasyTools">
                    <NavigationViewItem.Icon><ImageIcon Width="32" Height="32" Source="ms-appx:///Assets/Navigation/FantasyTools.png" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="GalExcleToolsNavItem" Content="剧情工具箱" Tag="GalExcleTools">
                    <NavigationViewItem.Icon><ImageIcon Width="32" Height="32" Source="ms-appx:///Assets/Navigation/GalExcleTools.png" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CrossingVoidZDToolNavItem" Content="ZD空界幻境" Tag="CrossingVoidZDTool">
                    <NavigationViewItem.Icon><ImageIcon Width="32" Height="32" Source="ms-appx:///Assets/Navigation/CrossingVoidZDTool.png" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="FantasyProjectPcNavItem" Content="幻杀启动器 PC" Tag="FantasyProjectPc">
                    <NavigationViewItem.Icon><ImageIcon Width="32" Height="32" Source="ms-appx:///Assets/Navigation/FantasyProjectPc.png" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CrossingVoidPcNavItem" Content="零境启动器 PC" Tag="CrossingVoidPc">
                    <NavigationViewItem.Icon><ImageIcon Width="32" Height="32" Source="ms-appx:///Assets/Navigation/CrossingVoidPc.png" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CrossingVoidAndroidNavItem" Content="零境启动器 Android" Tag="CrossingVoidAndroid">
                    <NavigationViewItem.Icon><ImageIcon Width="32" Height="32" Source="ms-appx:///Assets/Navigation/CrossingVoidAndroid.png" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="FantasyGameNavItem" Content="幻杀" Tag="FantasyGame">
                    <NavigationViewItem.Icon><ImageIcon Width="32" Height="32" Source="ms-appx:///Assets/Navigation/FantasyTools.png" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="FantasyAndroidNavItem" Content="幻杀启动器-安卓" Tag="FantasyAndroid">
                    <NavigationViewItem.Icon><ImageIcon Width="32" Height="32" Source="ms-appx:///Assets/Navigation/FantasyProjectPc.png" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CrossingVoidGameNavItem" Content="零境交错：空界幻境" Tag="CrossingVoidGame">
                    <NavigationViewItem.Icon><ImageIcon Width="32" Height="32" Source="ms-appx:///Assets/Navigation/CrossingVoidPc.png" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ServerAliyunNavItem" Content="服务器" Tag="ServerAliyun">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="World" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsNavItem" Content="整体设置" Tag="Settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Padding="20" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <views:ToolPage x:Name="AxToolsPage" />
                    <views:ToolPage x:Name="FantasyToolsPage" Visibility="Collapsed" />
                    <views:ToolPage x:Name="GalExcleToolsPage" Visibility="Collapsed" />
                    <views:ToolPage x:Name="CrossingVoidZDToolPage" Visibility="Collapsed" />
                    <views:ToolPage x:Name="FantasyProjectPcPage" Visibility="Collapsed" />
                    <views:ToolPage x:Name="CrossingVoidPcPage" Visibility="Collapsed" />
                    <views:ToolPage x:Name="CrossingVoidAndroidPage" Visibility="Collapsed" />
                    <views:ToolPage x:Name="FantasyGamePage" Visibility="Collapsed" />
                    <views:ToolPage x:Name="FantasyAndroidPage" Visibility="Collapsed" />
                    <views:ToolPage x:Name="CrossingVoidGamePage" Visibility="Collapsed" />
                    <views:ServerPage x:Name="ServerAliyunPage" Visibility="Collapsed" />
                    <views:SettingsPage x:Name="GlobalSettingsPage" Visibility="Collapsed" />
                </Grid>
                <StackPanel Grid.Row="1" Spacing="8">
                    <TextBlock
                        x:Name="WorkspacePathText"
                        Visibility="Collapsed"
                        TextTrimming="CharacterEllipsis"
                        Style="{StaticResource SubtleTextStyle}" />
                    <Border
                        x:Name="LogPanelBorder"
                        Style="{StaticResource PanelBorderStyle}"
                        Visibility="{Binding Settings.LogEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Padding="12,8,12,10" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="输出日志" Style="{StaticResource SectionTitleStyle}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <Button
                                        x:Name="ScrollLogToBottomButton"
                                        Click="ScrollLogToBottomButton_Click"
                                        Style="{StaticResource IconToolButtonStyle}"
                                        ToolTipService.ToolTip="滚动到底部">
                                        <SymbolIcon Symbol="Download" />
                                    </Button>
                                    <Button
                                        x:Name="CopyAllLogButton"
                                        Click="CopyAllLogButton_Click"
                                        Style="{StaticResource IconToolButtonStyle}"
                                        ToolTipService.ToolTip="复制全部日志">
                                        <SymbolIcon Symbol="Copy" />
                                    </Button>
                                    <Button
                                        x:Name="ClearLogButton"
                                        Click="ClearLogButton_Click"
                                        Style="{StaticResource IconToolButtonStyle}"
                                        ToolTipService.ToolTip="清空当前日志">
                                        <SymbolIcon Symbol="Delete" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <ScrollViewer
                                x:Name="LogScrollViewer"
                                Grid.Row="1"
                                MaxHeight="150"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto"
                                PointerWheelChanged="LogScrollViewer_PointerWheelChanged">
                                <ItemsControl
                                    x:Name="LogItemsControl"
                                    HorizontalContentAlignment="Stretch"
                                    ItemsSource="{Binding Logs}"
                                    PointerWheelChanged="LogScrollViewer_PointerWheelChanged">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                x:Name="LogEntryBorder"
                                                Margin="0,0,0,6"
                                                Padding="8,6"
                                                HorizontalAlignment="Stretch"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Tapped="LogEntryBorder_Tapped"
                                                Style="{Binding Kind, Converter={StaticResource LogKindToStyleConverter}, ConverterParameter=Block}">
                                                <TextBlock
                                                    Text="{Binding DisplayText}"
                                                    HorizontalAlignment="Stretch"
                                                    FontFamily="Consolas"
                                                    IsTextSelectionEnabled="False"
                                                    TextWrapping="Wrap"
                                                    Style="{Binding Kind, Converter={StaticResource LogKindToStyleConverter}, ConverterParameter=Text}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </NavigationView>

        <Border
            x:Name="GlobalProgressHost"
            Grid.RowSpan="2"
            MaxWidth="1540"
            Margin="28"
            Padding="22,18"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Canvas.ZIndex="320"
            CornerRadius="8"
            BorderBrush="{ThemeResource GlobalProgressHostBorderBrush}"
            BorderThickness="1"
            Background="{ThemeResource GlobalProgressHostBackgroundBrush}"
            DataContext="{Binding GlobalProgress}"
            Opacity="0"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform Y="130" />
            </Border.RenderTransform>
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="9">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="当前进度：" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource GlobalProgressPrimaryTextBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource GlobalProgressPrimaryTextBrush}" />
                        <TextBlock Grid.Column="2" Text="{Binding ElapsedText}" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource GlobalProgressPrimaryTextBrush}" />
                    </Grid>
                    <ProgressBar
                        Height="11"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding Percent}"
                        IsIndeterminate="{Binding IsIndeterminate}"
                        Foreground="{StaticResource GlobalProgressAccentBrush}"
                        Background="{StaticResource GlobalProgressTrackBrush}" />
                    <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource GlobalProgressSecondaryTextBrush}" />
                </StackPanel>
                <Grid Grid.Column="1" Width="86" Height="86">
                    <ProgressRing
                        x:Name="GlobalProgressRing"
                        Width="86"
                        Height="86"
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding Percent}"
                        IsActive="True"
                        IsIndeterminate="False"
                        IsHitTestVisible="False"
                        Foreground="{StaticResource GlobalProgressAccentBrush}" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{Binding PercentText}"
                        FontSize="20"
                        FontWeight="Bold"
                        IsHitTestVisible="False"
                        Foreground="{ThemeResource GlobalProgressPrimaryTextBrush}" />
                    <Button
                        Width="86"
                        Height="86"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0"
                        IsEnabled="{Binding CanCancel}"
                        Click="CancelGlobalTaskButton_Click"
                        AutomationProperties.Name="{Binding CancelLabel}"
                        ToolTipService.ToolTip="{Binding CancelLabel}" />
                </Grid>
            </Grid>
        </Border>
        <TeachingTip
            x:Name="LogTeachingTip"
            Grid.RowSpan="2"
            IsLightDismissEnabled="True"
            PreferredPlacement="Top" />
    </Grid>
</Window>
