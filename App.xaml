<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AxTools.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:AxTools.Converters"
    xmlns:local="using:AxTools">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- 令牌必须排在样式前面：ToolboxStyles 里的样式会引用这些数值。 -->
                <ResourceDictionary Source="Styles/DesignTokens.xaml" />
                <ResourceDictionary Source="Styles/ToolboxStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <converters:GameProjectStateBrushConverter x:Key="GameProjectStateBrushConverter" />
            <converters:ServerInstanceStateBrushConverter x:Key="ServerInstanceStateBrushConverter" />
            <converters:OperationNoticeSeverityConverter x:Key="OperationNoticeSeverityConverter" />
            <converters:LogKindToStyleConverter x:Key="LogKindToStyleConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
