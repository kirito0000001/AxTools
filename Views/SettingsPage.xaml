<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AxTools.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="Z"
            Modifiers="Control"
            Invoked="UndoLogSettingKeyboardAccelerator_Invoked" />
    </UserControl.KeyboardAccelerators>

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid HorizontalAlignment="Stretch" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4" Margin="0,0,0,2">
                <TextBlock Text="整体设置" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="管理固定工具、本机工具链、存储空间与显示设置。" Style="{StaticResource SubtleTextStyle}" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="12">
                    <Expander Header="夜间模式">
                        <Grid MinHeight="48" ColumnSpacing="12" Padding="0,10,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="应用主题" />
                                <TextBlock Text="选择后立即应用到当前窗口。" Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                            <ComboBox
                                x:Name="ThemeModeComboBox"
                                Grid.Column="1"
                                MinWidth="150"
                                SelectionChanged="ThemeModeComboBox_SelectionChanged">
                                <ComboBoxItem Content="跟随系统" />
                                <ComboBoxItem Content="浅色" />
                                <ComboBoxItem Content="深色" />
                            </ComboBox>
                        </Grid>
                    </Expander>

                    <Expander Header="整体项目位置">
                        <StackPanel Spacing="10" Padding="0,10,0,4">
                            <TextBlock Text="AxTools 设置、日志和任务记录保存在此目录。" Style="{StaticResource SubtleTextStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Header="文件目录"
                                    Text="{Binding ProjectRootPath, Mode=OneWay}"
                                    IsReadOnly="True" />
                                <Button
                                    Grid.Column="1"
                                    Margin="0,28,0,0"
                                    Content="选择位置"
                                    Click="ChooseProjectRootButton_Click"
                                    IsEnabled="{Binding CanChangeProjectRoot}"
                                    Style="{StaticResource PrimaryToolButtonStyle}"
                                    ToolTipService.ToolTip="选择父目录，程序会在其中创建 Ax工具箱项目 文件夹。" />
                            </Grid>
                            <InfoBar
                                IsOpen="True"
                                IsClosable="False"
                                Title="{Binding ProjectRootStatusTitle, Mode=OneWay}"
                                Message="{Binding ProjectRootStatusMessage, Mode=OneWay}"
                                Severity="{Binding ProjectRootStatusSeverity, Mode=OneWay, Converter={StaticResource OperationNoticeSeverityConverter}}" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="更新设置">
                        <StackPanel Spacing="10" Padding="0,10,0,4" DataContext="{Binding Update}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="160" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Header="更新源" ItemsSource="{Binding Sources}" SelectedItem="{Binding Source, Mode=TwoWay}" />
                                <ComboBox Grid.Column="1" Header="更新通道" ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel, Mode=TwoWay}" />
                                <NumberBox Grid.Column="2" Header="连接超时（秒）" Minimum="10" Maximum="600" Value="{Binding ConnectionTimeoutSeconds, Mode=TwoWay}" SpinButtonPlacementMode="Compact" />
                            </Grid>
                            <Grid MinHeight="42">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="自动检查更新" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding AutoCheckEnabled, Mode=TwoWay}" />
                            </Grid>
                            <Grid MinHeight="42">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="启动时检查" VerticalAlignment="Center" />
                                <ToggleSwitch Grid.Column="1" IsOn="{Binding CheckOnStartup, Mode=TwoWay}" />
                            </Grid>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding LastCheckDisplay}" Style="{StaticResource SubtleTextStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="CheckUpdateButton_Click" Style="{StaticResource PrimaryToolButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Sync" /><TextBlock Text="检查更新" /></StackPanel>
                                </Button>
                                <Button Click="DownloadUpdateButton_Click" IsEnabled="{Binding CanDownload}" Style="{StaticResource PrimaryToolButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Download" /><TextBlock Text="下载并校验" /></StackPanel>
                                </Button>
                                <Button Click="InstallUpdateButton_Click" IsEnabled="{Binding CanInstall}" Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="7"><SymbolIcon Symbol="Refresh" /><TextBlock Text="安装并重启" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Header="开发者发布中心">
                        <StackPanel
                            x:Name="DeveloperReleasePanel"
                            Spacing="10"
                            Padding="0,10,0,4"
                            DataContext="{Binding DeveloperRelease}"
                            Loaded="DeveloperReleasePanel_Loaded">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <NumberBox Header="主版本" Minimum="0" SpinButtonPlacementMode="Inline" Value="{Binding TargetVersionMajor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <NumberBox Grid.Column="1" Header="功能更新" Minimum="0" SpinButtonPlacementMode="Inline" Value="{Binding TargetVersionFeature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <NumberBox Grid.Column="2" Header="BUG修复" Minimum="0" SpinButtonPlacementMode="Inline" Value="{Binding TargetVersionBugFix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <ComboBox x:Name="ReleaseChannelComboBox" Grid.Column="1" Header="通道" SelectedValue="{Binding Channel, Mode=TwoWay}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="测试版" Tag="beta" IsSelected="True" />
                                    <ComboBoxItem Content="正式版" Tag="stable" />
                                </ComboBox>
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentPublishedVersion}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PublishedVersionStatus}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    Click="RefreshAxToolsPublishedVersion_Click"
                                    Style="{StaticResource PrimaryToolButtonStyle}"
                                    ToolTipService.ToolTip="重新检查 AxTools 线上发布版本">
                                    <SymbolIcon Symbol="Refresh" />
                                </Button>
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <PasswordBox x:Name="GiteeTokenPasswordBox" Header="Gitee Token" PasswordRevealMode="Peek" />
                                <Button Grid.Column="1" Margin="0,28,0,0" Click="SaveGiteeTokenButton_Click" Content="保存 Token" Style="{StaticResource PrimaryToolButtonStyle}" />
                            </Grid>
                            <TextBlock Text="{Binding GiteeTokenStatus}" Style="{StaticResource SubtleTextStyle}" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="EditAxToolsReleaseDescription_Click" Content="编辑 Release 介绍" Style="{StaticResource PrimaryToolButtonStyle}" />
                                <Button Tag="Package" Click="ReleaseActionButton_Click" Content="打包" Style="{StaticResource PrimaryToolButtonStyle}" />
                                <Button Tag="Validate" Click="ReleaseActionButton_Click" Content="校验产物" Style="{StaticResource PrimaryToolButtonStyle}" />
                                <Button Tag="Upload" Click="ReleaseActionButton_Click" Content="单独上传" Style="{StaticResource PrimaryToolButtonStyle}" />
                                <Button Tag="Publish" Click="ReleaseActionButton_Click" Content="完整发布" Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Header="任务运行器自检" IsExpanded="True">
                        <Border Style="{StaticResource PanelBorderStyle}" Padding="14" Margin="0,10,0,4">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding RunnerDiagnostics.StatusTitle}" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="{Binding RunnerDiagnostics.StatusDetail}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                                        <TextBlock Text="最近结果" Style="{StaticResource SubtleTextStyle}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding RunnerDiagnostics.LastResultText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Tag="success" Click="RunSelfTestButton_Click" IsEnabled="{Binding RunnerDiagnostics.CanStart}" Style="{StaticResource AccentButtonStyle}">
                                        <StackPanel Tag="成功流程" Orientation="Horizontal" Spacing="7">
                                            <SymbolIcon Symbol="Play" />
                                            <TextBlock Text="成功流程" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="failure" Click="RunSelfTestButton_Click" IsEnabled="{Binding RunnerDiagnostics.CanStart}" Style="{StaticResource PrimaryToolButtonStyle}">
                                        <StackPanel Tag="失败流程" Orientation="Horizontal" Spacing="7">
                                            <SymbolIcon Symbol="Important" />
                                            <TextBlock Text="失败流程" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="stop" Click="RunSelfTestButton_Click" IsEnabled="{Binding RunnerDiagnostics.CanStart}" Style="{StaticResource PrimaryToolButtonStyle}">
                                        <StackPanel Tag="停止测试" Orientation="Horizontal" Spacing="7">
                                            <SymbolIcon Symbol="Stop" />
                                            <TextBlock Text="停止测试" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="invalid" Click="RunSelfTestButton_Click" IsEnabled="{Binding RunnerDiagnostics.CanStart}" Style="{StaticResource PrimaryToolButtonStyle}">
                                        <StackPanel Tag="协议兼容" Orientation="Horizontal" Spacing="7">
                                            <SymbolIcon Symbol="Sync" />
                                            <TextBlock Text="协议兼容" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="locked" Click="RunSelfTestButton_Click" IsEnabled="{Binding RunnerDiagnostics.CanStart}" Style="{StaticResource PrimaryToolButtonStyle}">
                                        <StackPanel Tag="不可停止阶段" Orientation="Horizontal" Spacing="7">
                                            <SymbolIcon Symbol="Permissions" />
                                            <TextBlock Text="不可停止阶段" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock
                                    Text="自检只运行 AxTools 随包诊断脚本，不访问三个受管工具。"
                                    Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Expander Header="存储管理">
                        <StackPanel Spacing="10" Padding="0,10,0,4" DataContext="{Binding Storage}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="空间扫描与白名单清理" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SelectedSummary}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Click="ScanStorageButton_Click"
                                    IsEnabled="{Binding CanScan}"
                                    Style="{StaticResource PrimaryToolButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <SymbolIcon Symbol="Find" />
                                        <TextBlock Text="扫描空间" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Column="2"
                                    Click="CleanupStorageButton_Click"
                                    IsEnabled="{Binding CanCleanSelected}"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <SymbolIcon Symbol="Delete" />
                                        <TextBlock Text="清理所选" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PanelBorderStyle}" Padding="12" Margin="0,4,0,0">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanClean}" VerticalAlignment="Top" />
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Path}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Impact}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="2">
                                                    <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding GrowthText}" Style="{StaticResource SubtleTextStyle}" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding CategoryText}" Style="{StaticResource SubtleTextStyle}" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding LastModifiedText}" Style="{StaticResource SubtleTextStyle}" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <Expander Header="环境中心">
                        <StackPanel Spacing="12" Padding="0,10,0,4" DataContext="{Binding Environment}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="整机开发环境档案" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ChangeSummary}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Click="RescanEnvironmentButton_Click"
                                    IsEnabled="{Binding CanRescan}"
                                    Style="{StaticResource PrimaryToolButtonStyle}"
                                    ToolTipService.ToolTip="重新读取已知项目与本机环境配置">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <SymbolIcon Symbol="Sync" />
                                        <TextBlock Text="重新扫描" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <InfoBar
                                IsOpen="True"
                                IsClosable="False"
                                Severity="Informational"
                                Message="AxTools 只为自己启动的任务注入路径，不修改系统环境变量；安装环境仅统计，需通过 Visual Studio Installer 或 Android SDK Manager 维护。" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="0,2,0,0">
                                            <Expander.Header>
                                                <Grid MinHeight="46" ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding HealthText}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding CurrentVersionDisplay}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Expander.Header>
                                            <StackPanel Spacing="9" Padding="0,8,0,6">
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Message}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                                                <Grid ColumnSpacing="14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="当前版本" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding CurrentVersionDisplay}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="3">
                                                        <TextBlock Text="推荐版本" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding RecommendedVersionDisplay}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                                <TextBox Header="安装或执行路径" Text="{Binding Path}" IsReadOnly="True" TextWrapping="Wrap" />
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="使用程序与判断依据" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ConsumerDetailsText}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="管理方式" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ManagementText}" />
                                                    <TextBlock Text="{Binding ManagementHint}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <Grid ColumnSpacing="14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding LastModifiedText}" Style="{StaticResource SubtleTextStyle}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ChangeSummaryDisplay}" Style="{StaticResource SubtleTextStyle}" TextWrapping="Wrap" />
                                                </Grid>
                                            </StackPanel>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBox Header="PowerShell 7" Text="{Binding Settings.PowerShellPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Header=".NET SDK" Text="{Binding Settings.DotNetPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Header="Node.js" Text="{Binding Settings.NodePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Header="npm" Text="{Binding Settings.NpmPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Header="Rust / Cargo" Text="{Binding Settings.CargoPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Header="JDK Home" Text="{Binding Settings.JavaHome, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Header="Android JDK 21" Text="{Binding Settings.AndroidJavaHome, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Header="Android SDK" Text="{Binding Settings.AndroidSdkRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Header="Bandizip" Text="{Binding Settings.BandizipPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="受管工具路径">
                        <ItemsControl ItemsSource="{Binding Tools}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PanelBorderStyle}" Padding="14" Margin="0,8,0,0">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock
                                                Text="{Binding PathDetectionStatus}"
                                                Visibility="{Binding HasPathDetectionStatus, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Style="{StaticResource SubtleTextStyle}"
                                                TextWrapping="Wrap" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Header="源码目录" Text="{Binding SourceRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button Grid.Column="1" Tag="SourceRoot" Click="SelectPathButton_Click" Style="{StaticResource IconToolButtonStyle}" ToolTipService.ToolTip="选择源码目录">
                                                    <SymbolIcon Symbol="Folder" />
                                                </Button>
                                            </Grid>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Header="开发版程序" Text="{Binding DevelopmentExecutable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button Grid.Column="1" Tag="DevelopmentExecutable" Click="SelectPathButton_Click" Style="{StaticResource IconToolButtonStyle}" ToolTipService.ToolTip="选择开发版程序">
                                                    <SymbolIcon Symbol="OpenFile" />
                                                </Button>
                                            </Grid>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox Header="正式版程序" Text="{Binding ReleaseExecutable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button Grid.Column="1" Tag="ReleaseExecutable" Click="SelectPathButton_Click" Style="{StaticResource IconToolButtonStyle}" ToolTipService.ToolTip="选择正式版程序">
                                                    <SymbolIcon Symbol="OpenFile" />
                                                </Button>
                                            </Grid>
                                            <TextBox
                                                x:Name="WorkspaceOutputRootTextBox"
                                                Header="工作区产物目录"
                                                IsReadOnly="True"
                                                Text="{Binding OutputRoot, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <Expander Header="辅助显示">
                        <Grid MinHeight="48" ColumnSpacing="12" Padding="0,10,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="显示整体项目位置" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1" IsOn="{Binding ShowWorkspacePath, Mode=TwoWay}" />
                        </Grid>
                    </Expander>

                    <Expander Header="Log 输出">
                        <StackPanel Spacing="10" Padding="0,10,0,4">
                            <Grid MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="开启 Log 功能" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="1" IsChecked="{Binding LogEnabled, Mode=TwoWay}" />
                            </Grid>
                            <Grid MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="保存 Log 到文件" VerticalAlignment="Center" />
                                <CheckBox
                                    Grid.Column="1"
                                    IsChecked="{Binding LogSaveToFileEnabled, Mode=TwoWay}"
                                    IsEnabled="{Binding AreLogOptionsEnabled}" />
                            </Grid>
                            <Grid MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Log 输出用户操作" VerticalAlignment="Center" />
                                <CheckBox
                                    Grid.Column="1"
                                    IsChecked="{Binding LogUserOperations, Mode=TwoWay}"
                                    IsEnabled="{Binding AreLogOptionsEnabled}" />
                            </Grid>
                            <Grid MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Log 输出提示" VerticalAlignment="Center" />
                                <CheckBox
                                    Grid.Column="1"
                                    IsChecked="{Binding LogWarnings, Mode=TwoWay}"
                                    IsEnabled="{Binding AreLogOptionsEnabled}" />
                            </Grid>
                            <Grid MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Log 输出错误提示" VerticalAlignment="Center" />
                                <CheckBox
                                    Grid.Column="1"
                                    IsChecked="{Binding LogErrors, Mode=TwoWay}"
                                    IsEnabled="{Binding AreLogOptionsEnabled}" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                </StackPanel>

                <Border Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource PanelBorderStyle}">
                    <StackPanel Padding="16" Spacing="12">
                        <Border
                            Width="86"
                            Height="86"
                            CornerRadius="16"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <Viewbox Width="42" Height="42">
                                <SymbolIcon Symbol="Repair" Foreground="White" />
                            </Viewbox>
                        </Border>
                        <StackPanel Spacing="4">
                            <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}" FontSize="20" />
                            <TextBlock Text="Ax工具箱" FontWeight="SemiBold" FontSize="18" />
                            <TextBlock x:Name="AboutVersionText" Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                        <TextBlock Text="统一管理工具的开发、构建与发布流程。" Style="{StaticResource SubtleTextStyle}" />
                        <StackPanel Spacing="8">
                            <TextBlock Text="制作人员" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="企划 / 使用设计：柳雨" Style="{StaticResource SubtleTextStyle}" />
                            <TextBlock Text="程序协作：Codex" Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
