<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AxTools.Views.ToolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="ToolPage_SizeChanged">

    <UserControl.Resources>
        <DataTemplate x:Key="ToolActionButtonTemplate">
            <Button
                Height="40"
                Margin="0,0,8,8"
                Click="ToolAction_Click"
                HorizontalAlignment="Stretch"
                IsEnabled="{Binding IsEnabled}"
                Style="{StaticResource PrimaryToolButtonStyle}"
                ToolTipService.ToolTip="{Binding Description}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="{Binding IconGlyph}" FontSize="16" />
                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        Padding="0,0,20,0"
        VerticalScrollBarVisibility="Auto">
        <Grid HorizontalAlignment="Stretch" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4" Margin="0,0,0,2">
                <TextBlock Text="{Binding DisplayName}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource SubtleTextStyle}" />
                <Button
                    x:Name="ActionHelpButton"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Click="ShowActionHelp_Click"
                    Style="{StaticResource PrimaryToolButtonStyle}"
                    ToolTipService.ToolTip="查看当前工具全部按钮的功能和影响">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <SymbolIcon Symbol="Help" />
                        <TextBlock Text="功能说明" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <InfoBar
                Grid.Row="1"
                IsClosable="False"
                IsOpen="True"
                Severity="Informational"
                Title="配置状态"
                Message="{Binding ConfigurationStatus}" />

            <SelectorBar
                x:Name="ModeSelector"
                Grid.Row="2"
                SelectionChanged="ModeSelector_SelectionChanged">
                <SelectorBarItem x:Name="DevelopmentSelectorItem" Text="开发版" IsSelected="True" />
                <SelectorBarItem x:Name="ReleaseSelectorItem" Text="正式版" />
                <SelectorBarItem
                    x:Name="PublishSelectorItem"
                    Text="打包与发布"
                    Visibility="{Binding HasPublishActions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <SelectorBarItem x:Name="StorageSelectorItem" Text="存储清理" />
            </SelectorBar>

            <Grid Grid.Row="3">
                <Border x:Name="DevelopmentPanel" Style="{StaticResource PanelBorderStyle}" Padding="18">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="开发版" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="构建和启动源码开发版本。" Style="{StaticResource SubtleTextStyle}" />
                            <TextBlock Text="{Binding DevelopmentVersionText}" Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                        <ItemsControl
                            ItemsSource="{Binding DevelopmentPanelActions}"
                            Loaded="ActionItemsControl_Loaded"
                            SizeChanged="ActionItemsControl_SizeChanged"
                            ItemTemplate="{StaticResource ToolActionButtonTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="{Binding ExecutionAvailabilityText}" Style="{StaticResource SubtleTextStyle}" />
                        <TextBlock Text="{Binding LastResultText}" Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>
                </Border>

                <Border x:Name="ReleasePanel" Visibility="Collapsed" Style="{StaticResource PanelBorderStyle}" Padding="18">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="正式版" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="启动已安装或已打包的正式程序。" Style="{StaticResource SubtleTextStyle}" />
                            <TextBlock Text="{Binding ReleaseVersionText}" Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                        <ItemsControl
                            ItemsSource="{Binding ReleasePanelActions}"
                            Loaded="ActionItemsControl_Loaded"
                            SizeChanged="ActionItemsControl_SizeChanged"
                            ItemTemplate="{StaticResource ToolActionButtonTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="{Binding ExecutionAvailabilityText}" Style="{StaticResource SubtleTextStyle}" />
                        <TextBlock Text="{Binding LastResultText}" Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>
                </Border>

                <Border x:Name="PublishPanel" Visibility="Collapsed" Style="{StaticResource PanelBorderStyle}" Padding="18">
                    <StackPanel Spacing="22">
                        <StackPanel
                            x:Name="LauncherPublishingSection"
                            Spacing="14"
                            Visibility="{Binding HasLauncherPublishActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="启动器发布" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="构建、校验并发布启动器自身的新版本。" Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                            <Grid x:Name="LauncherPublishingFields" ColumnSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="LauncherChannelField"
                                    Header="启动器通道"
                                    HorizontalAlignment="Stretch"
                                    SelectedValue="{Binding PublishChannel, Mode=TwoWay}"
                                    SelectedValuePath="Tag">
                                    <ComboBoxItem Content="正式版" Tag="stable" />
                                    <ComboBoxItem Content="测试版" Tag="beta" />
                                </ComboBox>
                                <Grid
                                    x:Name="LauncherVersionField"
                                    Grid.Column="1"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox x:Name="LauncherMajorVersionNumberBox" Header="主版本" Minimum="0" SpinButtonPlacementMode="Inline" Value="{Binding PublishVersionMajor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <NumberBox x:Name="LauncherFeatureVersionNumberBox" Grid.Column="1" Header="功能更新" Minimum="0" SpinButtonPlacementMode="Inline" Value="{Binding PublishVersionFeature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <NumberBox x:Name="LauncherBugFixVersionNumberBox" Grid.Column="2" Header="BUG修复" Minimum="0" SpinButtonPlacementMode="Inline" Value="{Binding PublishVersionBugFix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Grid>
                            <TextBlock
                                Text="{Binding LauncherVersionStateText}"
                                Style="{StaticResource SubtleTextStyle}"
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding LauncherPublishedVersionText}"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{Binding LauncherVersionCheckStatus}"
                                        Style="{StaticResource SubtleTextStyle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    Click="RefreshLauncherVersion_Click"
                                    Style="{StaticResource PrimaryToolButtonStyle}"
                                    ToolTipService.ToolTip="重新检查线上启动器版本">
                                    <SymbolIcon Symbol="Refresh" />
                                </Button>
                            </Grid>
                            <ItemsControl
                                ItemsSource="{Binding LauncherPublishActions}"
                                Loaded="ActionItemsControl_Loaded"
                                SizeChanged="ActionItemsControl_SizeChanged"
                                ItemTemplate="{StaticResource ToolActionButtonTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <Border
                            Height="1"
                            Background="{ThemeResource CardStrokeColorDefaultBrush}"
                            Visibility="{Binding HasGamePackagePublishing, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <StackPanel
                            x:Name="GamePublishingSection"
                            Spacing="14"
                            Visibility="{Binding HasGamePackagePublishing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding GamePublishingTitle}" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{Binding GamePublishingDescription}" Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                            <Grid x:Name="GamePublishingFields" ColumnSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="GameChannelField"
                                    Header="游戏通道"
                                    HorizontalAlignment="Stretch"
                                    SelectedValue="{Binding GamePublishChannel, Mode=TwoWay}"
                                    SelectedValuePath="Tag">
                                    <ComboBoxItem Content="正式服" Tag="stable" />
                                    <ComboBoxItem Content="测试服" Tag="beta" />
                                </ComboBox>
                                <ComboBox
                                    x:Name="GamePlatformField"
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Header="游戏平台"
                                    HorizontalAlignment="Stretch"
                                    SelectedValue="{Binding GamePublishPlatform, Mode=TwoWay}"
                                    SelectedValuePath="Tag">
                                    <ComboBoxItem Content="PC" Tag="Windows" />
                                    <ComboBoxItem Content="Android" Tag="Android" />
                                </ComboBox>
                                <Grid
                                    x:Name="GameVersionField"
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox x:Name="GameMajorVersionNumberBox" Header="主版本" Minimum="0" SpinButtonPlacementMode="Inline" Value="{Binding GameVersionMajor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <NumberBox x:Name="GameFeatureVersionNumberBox" Grid.Column="1" Header="功能更新" Minimum="0" SpinButtonPlacementMode="Inline" Value="{Binding GameVersionFeature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <NumberBox x:Name="GameBugFixVersionNumberBox" Grid.Column="2" Header="BUG修复" Minimum="0" SpinButtonPlacementMode="Inline" Value="{Binding GameVersionBugFix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Grid>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding GamePublishedVersionText}"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{Binding GameVersionCheckStatus}"
                                        Style="{StaticResource SubtleTextStyle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    Click="RefreshGameVersion_Click"
                                    Style="{StaticResource PrimaryToolButtonStyle}"
                                    ToolTipService.ToolTip="同时检查 PC 与 Android 线上游戏版本">
                                    <SymbolIcon Symbol="Refresh" />
                                </Button>
                            </Grid>
                            <Grid
                                x:Name="GamePackagePathRow"
                                ColumnSpacing="10"
                                Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Header="{Binding GamePackageLabel}"
                                    IsReadOnly="True"
                                    Text="{Binding GamePackageRoot, Mode=OneWay}" />
                                <Button
                                    x:Name="GamePackageRootBrowseButton"
                                    Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    Margin="0,24,0,0"
                                    HorizontalAlignment="Stretch"
                                    Click="GamePackageRootBrowse_Click"
                                    Style="{StaticResource PrimaryToolButtonStyle}"
                                    ToolTipService.ToolTip="选择游戏打包目录">
                                    <FontIcon Glyph="&#xE8B7;" />
                                </Button>
                            </Grid>
                            <ItemsControl
                                ItemsSource="{Binding GamePublishActions}"
                                Loaded="ActionItemsControl_Loaded"
                                SizeChanged="ActionItemsControl_SizeChanged"
                                ItemTemplate="{StaticResource ToolActionButtonTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="{Binding ExecutionAvailabilityText}" Style="{StaticResource SubtleTextStyle}" />
                        <TextBlock Text="{Binding LastResultText}" Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>
                </Border>

                <Border x:Name="StoragePanel" Visibility="Collapsed" Style="{StaticResource PanelBorderStyle}" Padding="18">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="存储清理" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="先扫描占用，再选择固定白名单中的缓存目录。" Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                        <Button
                            Content="扫描空间占用"
                            Height="40"
                            IsEnabled="{Binding IsStorageAvailable}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource PrimaryToolButtonStyle}" />
                        <TextBlock Text="{Binding StorageAvailabilityText}" Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
