<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AxTools.Views.ToolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="ToolPage_SizeChanged">

    <UserControl.Resources>
        <DataTemplate x:Key="ToolActionButtonTemplate">
            <Button
                Height="40"
                Margin="0,0,8,8"
                Click="ToolAction_Click"
                HorizontalAlignment="Stretch"
                IsEnabled="{Binding IsEnabled}"
                Style="{StaticResource PrimaryToolButtonStyle}"
                ToolTipService.ToolTip="{Binding Description}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AxSpace8}">
                    <FontIcon Glyph="{Binding IconGlyph}" FontSize="16" />
                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer
        x:Name="PageScrollViewer"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <!-- 右侧留白放在内容 Grid 的 Margin 上，而不是 ScrollViewer.Padding：
             Padding 不参与内容测量，右对齐的按钮会顶到滚动条下面被挡住。 -->
        <Grid
            x:Name="PageContentGrid"
            HorizontalAlignment="Stretch"
            Margin="{StaticResource AxPagePadding}"
            RowSpacing="{StaticResource AxSpace16}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="{StaticResource AxSpace4}" Margin="0,0,0,2">
                <TextBlock x:Name="PageTitleText" Text="{Binding DisplayName}" Style="{StaticResource PageTitleStyle}" />
                <!-- 游戏页不显示这行工具描述；缺什么由顶部「配置状态」通知栏说明。 -->
                <TextBlock
                    x:Name="PageDescriptionText"
                    Text="{Binding Description}"
                    Visibility="{Binding IsGameTool, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                    Style="{StaticResource SubtleTextStyle}" />
            </StackPanel>

            <InfoBar
                Grid.Row="1"
                IsClosable="False"
                IsOpen="True"
                Severity="{Binding ConfigurationSeverity, Converter={StaticResource OperationNoticeSeverityConverter}}"
                Title="配置状态"
                Message="{Binding ConfigurationStatus}" />

            <SelectorBar
                x:Name="ModeSelector"
                Grid.Row="2"
                SelectionChanged="ModeSelector_SelectionChanged">
                <SelectorBarItem x:Name="DevelopmentSelectorItem" Text="开发版" IsSelected="True" />
                <SelectorBarItem
                    x:Name="PublishSelectorItem"
                    Text="{Binding PublishTabTitle}"
                    Visibility="{Binding HasPublishActions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <SelectorBarItem
                    x:Name="LauncherSelectorItem"
                    Text="启动器打包"
                    Visibility="{Binding HasLauncherPackaging, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <SelectorBarItem
                    x:Name="ServerSelectorItem"
                    Text="服务器"
                    Visibility="{Binding IsGameTool, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <SelectorBarItem
                    x:Name="FragmentSelectorItem"
                    Text="碎片制作"
                    Visibility="{Binding HasFragmentGeneration, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <SelectorBarItem x:Name="StorageSelectorItem" Text="存储清理" />
                <SelectorBarItem
                    x:Name="SettingsSelectorItem"
                    Text="设置"
                    Visibility="{Binding IsGameTool, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </SelectorBar>

            <Grid Grid.Row="3">
                <Border x:Name="DevelopmentPanel" Style="{StaticResource PanelBorderStyle}" Padding="{StaticResource AxPanelPadding}">
                    <StackPanel Spacing="{StaticResource AxSpace14}">
                        <!-- 非游戏工具：保留原来的开发版说明与动作列表。 -->
                        <StackPanel
                            Spacing="{StaticResource AxSpace4}"
                            Visibility="{Binding IsGameTool, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <TextBlock Text="开发版" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="构建和启动源码开发版本。" Style="{StaticResource SubtleTextStyle}" />
                            <TextBlock Text="{Binding DevelopmentVersionText}" Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                        <ItemsControl
                            ItemsSource="{Binding DevelopmentPanelActions}"
                            Loaded="ActionItemsControl_Loaded"
                            SizeChanged="ActionItemsControl_SizeChanged"
                            Visibility="{Binding IsGameTool, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                            ItemTemplate="{StaticResource ToolActionButtonTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock
                            Text="{Binding ExecutionAvailabilityText}"
                            Visibility="{Binding IsGameTool, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                            Style="{StaticResource SubtleTextStyle}" />

                        <!-- 游戏页：一片一片的卡片。第一片是项目本体；开了安卓启动器再加一片。 -->
                        <ItemsControl
                            ItemsSource="{Binding GameProjectCards}"
                            Visibility="{Binding IsGameTool, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,12"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource AxRadiusMedium}"
                                        Padding="16">
                                        <StackPanel Spacing="{StaticResource AxSpace12}">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource GroupTitleStyle}" />
                                            <ItemsControl ItemsSource="{Binding Actions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="220" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button
                                                            Margin="0,0,8,8"
                                                            IsEnabled="{Binding IsEnabled}"
                                                            Click="GameProjectAction_Click"
                                                            Style="{StaticResource CardActionButtonStyle}">
                                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AxSpace8}">
                                                                <FontIcon Glyph="{Binding Glyph}" FontSize="16" />
                                                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock
                            Text="{Binding LastResultText}"
                            Visibility="{Binding IsGameTool, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                            Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>
                </Border>

                <Border x:Name="PublishPanel" Visibility="Collapsed" Style="{StaticResource PanelBorderStyle}" Padding="{StaticResource AxPanelPadding}">
                    <StackPanel Spacing="{StaticResource AxSpace16}">
                        <StackPanel x:Name="LegacyPublishSection" Spacing="{StaticResource AxSpace22}" Visibility="Collapsed">
                        <StackPanel
                            x:Name="LauncherPublishingSection"
                            Spacing="{StaticResource AxSpace14}"
                            Visibility="{Binding HasLauncherPublishActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Spacing="{StaticResource AxSpace4}">
                                <TextBlock Text="启动器发布" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="构建、校验并发布启动器自身的新版本。" Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                            <Grid x:Name="LauncherPublishingFields" ColumnSpacing="{StaticResource AxSpace12}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="LauncherChannelField"
                                    Header="启动器通道"
                                    HorizontalAlignment="Stretch"
                                    SelectedValue="{Binding PublishChannel, Mode=TwoWay}"
                                    SelectedValuePath="Tag">
                                    <ComboBoxItem Content="正式版" Tag="stable" />
                                    <ComboBoxItem Content="测试版" Tag="beta" />
                                </ComboBox>
                                <Grid
                                    x:Name="LauncherVersionField"
                                    Grid.Column="1"
                                    ColumnSpacing="{StaticResource AxSpace8}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox x:Name="LauncherMajorVersionNumberBox" Header="主版本" Minimum="0" SpinButtonPlacementMode="Inline" Value="{Binding PublishVersionMajor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <NumberBox x:Name="LauncherFeatureVersionNumberBox" Grid.Column="1" Header="功能更新" Minimum="0" SpinButtonPlacementMode="Inline" Value="{Binding PublishVersionFeature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <NumberBox x:Name="LauncherBugFixVersionNumberBox" Grid.Column="2" Header="BUG修复" Minimum="0" SpinButtonPlacementMode="Inline" Value="{Binding PublishVersionBugFix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Grid>
                            <TextBlock
                                Text="{Binding LauncherVersionStateText}"
                                Style="{StaticResource SubtleTextStyle}"
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="{StaticResource AxSpace10}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource AxSpace2}" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding LauncherPublishedVersionText}"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{Binding LauncherVersionCheckStatus}"
                                        Style="{StaticResource SubtleTextStyle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    Click="RefreshLauncherVersion_Click"
                                    Style="{StaticResource IconToolButtonStyle}"
                                    ToolTipService.ToolTip="重新检查线上启动器版本">
                                    <SymbolIcon Symbol="Refresh" />
                                </Button>
                            </Grid>
                            <ItemsControl
                                ItemsSource="{Binding LauncherPublishActions}"
                                Loaded="ActionItemsControl_Loaded"
                                SizeChanged="ActionItemsControl_SizeChanged"
                                ItemTemplate="{StaticResource ToolActionButtonTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <Border
                            Height="1"
                            Background="{ThemeResource CardStrokeColorDefaultBrush}"
                            Visibility="{Binding HasGamePackagePublishing, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <StackPanel
                            x:Name="GamePublishingSection"
                            Spacing="{StaticResource AxSpace14}"
                            Visibility="{Binding HasGamePackagePublishing, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel x:Name="GamePublishingHeader" Spacing="{StaticResource AxSpace4}">
                                <TextBlock Text="{Binding GamePublishingTitle}" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{Binding GamePublishingDescription}" Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                            <Grid x:Name="GamePublishingFields" ColumnSpacing="{StaticResource AxSpace12}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="GamePlatformField"
                                    Grid.Column="0"
                                    Header="游戏平台"
                                    HorizontalAlignment="Stretch"
                                    SelectedValue="{Binding GamePublishPlatform, Mode=TwoWay}"
                                    SelectedValuePath="Tag">
                                    <ComboBoxItem Content="PC" Tag="Windows" />
                                    <ComboBoxItem Content="Android" Tag="Android" />
                                </ComboBox>
                                <StackPanel
                                    x:Name="GameVersionField"
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Spacing="{StaticResource AxSpace2}">
                                    <TextBlock
                                        Text="游戏版本（由打包产物 Version.json 决定，不可手填）"
                                        Style="{StaticResource SubtleTextStyle}" />
                                    <TextBlock
                                        Text="{Binding GamePackageVersionText}"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnSpacing="{StaticResource AxSpace10}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="{StaticResource AxSpace2}" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding GamePublishedVersionText}"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{Binding GameVersionCheckStatus}"
                                        Style="{StaticResource SubtleTextStyle}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    Click="RefreshGameVersion_Click"
                                    Style="{StaticResource IconToolButtonStyle}"
                                    ToolTipService.ToolTip="同时检查 PC 与 Android 线上游戏版本">
                                    <SymbolIcon Symbol="Refresh" />
                                </Button>
                            </Grid>
                            <Grid
                                x:Name="GamePackagePathRow"
                                ColumnSpacing="{StaticResource AxSpace10}"
                                Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Header="{Binding GamePackageLabel}"
                                    IsReadOnly="True"
                                    Text="{Binding GamePackageRoot, Mode=OneWay}" />
                                <Button
                                    x:Name="GamePackageRootBrowseButton"
                                    Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    Margin="0,24,0,0"
                                    HorizontalAlignment="Stretch"
                                    Click="GamePackageRootBrowse_Click"
                                    Style="{StaticResource IconToolButtonStyle}"
                                    ToolTipService.ToolTip="选择游戏打包目录">
                                    <FontIcon Glyph="&#xE8B7;" />
                                </Button>
                            </Grid>
                            <ItemsControl
                                ItemsSource="{Binding GamePublishActions}"
                                Loaded="ActionItemsControl_Loaded"
                                SizeChanged="ActionItemsControl_SizeChanged"
                                ItemTemplate="{StaticResource ToolActionButtonTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <Expander
                                x:Name="GameMaintenanceArea"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Visibility="{Binding HasGameMaintenanceActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Expander.Header>
                                    <TextBlock Text="维护（额外）" Style="{StaticResource SubtleTextStyle}" />
                                </Expander.Header>
                                <StackPanel Spacing="{StaticResource AxSpace8}">
                                    <TextBlock
                                        Text="平时用不到。只有本机暂存仓库的对象涨得太大、需要重新压一遍时才点。"
                                        Style="{StaticResource SubtleTextStyle}"
                                        TextWrapping="Wrap" />
                                    <ItemsControl
                                        ItemsSource="{Binding GameMaintenanceActions}"
                                        Loaded="ActionItemsControl_Loaded"
                                        SizeChanged="ActionItemsControl_SizeChanged"
                                        ItemTemplate="{StaticResource ToolActionButtonTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <TextBlock Text="{Binding ExecutionAvailabilityText}" Style="{StaticResource SubtleTextStyle}" />
                        <TextBlock Text="{Binding LastResultText}" Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 启动器打包：只管理安卓启动器；不开「安卓启动器」不出现。 -->
                <Border x:Name="LauncherPanel" Visibility="Collapsed" Style="{StaticResource PanelBorderStyle}" Padding="{StaticResource AxPanelPadding}">
                    <StackPanel Spacing="{StaticResource AxSpace14}">
                        <TextBlock Text="启动器打包" Style="{StaticResource GroupTitleStyle}" />
                        <TextBlock
                            Text="安卓启动器的版本号与发布；不再区分正式版与测试版。"
                            Style="{StaticResource SubtleTextStyle}" />

                        <Grid ColumnSpacing="{StaticResource AxSpace8}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox
                                Header="主版本"
                                Minimum="0"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding LauncherVersionMajor, Mode=TwoWay}" />
                            <NumberBox
                                Grid.Column="1"
                                Header="功能更新"
                                Minimum="0"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding LauncherVersionFeature, Mode=TwoWay}" />
                            <NumberBox
                                Grid.Column="2"
                                Header="BUG修复"
                                Minimum="0"
                                SpinButtonPlacementMode="Inline"
                                Value="{Binding LauncherVersionBugFix, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnSpacing="{StaticResource AxSpace10}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{Binding LauncherPackagingStatusText}"
                                Style="{StaticResource SubtleTextStyle}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center" />
                            <Button
                                Grid.Column="1"
                                Click="RefreshLauncherPackaging_Click"
                                Style="{StaticResource IconToolButtonStyle}"
                                ToolTipService.ToolTip="重新检查线上启动器版本">
                                <SymbolIcon Symbol="Refresh" />
                            </Button>
                        </Grid>

                        <Button
                            Content="发布新版本"
                            HorizontalAlignment="Left"
                            Click="PublishLauncher_Click"
                            Style="{StaticResource CardActionButtonStyle}" />
                    </StackPanel>
                </Border>

                <!-- 服务器：服务端状态与操作单独一页，不再挤在发布区里。 -->
                <Border x:Name="ServerPanel" Visibility="Collapsed" Style="{StaticResource PanelBorderStyle}" Padding="{StaticResource AxPanelPadding}">
                    <StackPanel Spacing="{StaticResource AxSpace16}">
                        <!-- 第一片：服务端推送（版本状态 + 实例 + 七个动作）。 -->
                        <Border
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AxRadiusMedium}"
                            Padding="16">
                            <StackPanel Spacing="{StaticResource AxSpace12}">
                                <TextBlock Text="{Binding ServerPushCardTitle}" Style="{StaticResource GroupTitleStyle}" />
                                <TextBlock Text="{Binding ServerStateStatus}" Style="{StaticResource SubtleTextStyle}" />

                                <StackPanel Spacing="{StaticResource AxSpace12}" Visibility="{Binding HasServerUpdate, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl ItemsSource="{Binding ServerInstances}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,0,0,8"
                                                    Padding="12,10,12,10"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource AxRadiusMedium}">
                                                    <Grid ColumnSpacing="{StaticResource AxSpace12}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Ellipse
                                                            Width="10"
                                                            Height="10"
                                                            VerticalAlignment="Center"
                                                            Fill="{Binding StateKey, Converter={StaticResource ServerInstanceStateBrushConverter}}" />
                                                        <StackPanel Grid.Column="1" Spacing="{StaticResource AxSpace6}">
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding EndpointText}" Style="{StaticResource SubtleTextStyle}" />
                                                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource AxSpace8}">
                                                                <Button Content="日志" Tag="log" Click="InstanceAction_Click" Style="{StaticResource PrimaryToolButtonStyle}" />
                                                                <Button Content="启动" Tag="start" Click="InstanceAction_Click" Style="{StaticResource PrimaryToolButtonStyle}" />
                                                                <Button Content="停止" Tag="stop" Click="InstanceAction_Click" Style="{StaticResource PrimaryToolButtonStyle}" />
                                                                <Button Content="重启" Tag="restart" Click="InstanceAction_Click" Style="{StaticResource PrimaryToolButtonStyle}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel
                                                            Grid.Column="2"
                                                            HorizontalAlignment="Right"
                                                            Spacing="{StaticResource AxSpace2}">
                                                            <TextBlock
                                                                Text="{Binding StatusText}"
                                                                HorizontalAlignment="Right"
                                                                FontSize="13" />
                                                            <TextBlock
                                                                Text="{Binding DetailText}"
                                                                HorizontalAlignment="Right"
                                                                Style="{StaticResource SubtleTextStyle}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock
                                        Text="尚未读取到实例信息。"
                                        Visibility="{Binding HasServerInstances, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                        Style="{StaticResource SubtleTextStyle}" />

                                    <ItemsControl ItemsSource="{Binding ServerUpdateLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,4" ColumnSpacing="{StaticResource AxSpace12}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Text="{Binding Label}"
                                                        TextWrapping="NoWrap"
                                                        Style="{StaticResource SubtleTextStyle}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 功能按钮：执行逻辑复用旧服务器页那套，不在这里重写。 -->
                                    <ItemsControl ItemsSource="{Binding ServerActions}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ItemsWrapGrid Orientation="Horizontal" ItemWidth="200" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Margin="0,0,8,8"
                                                    IsEnabled="{Binding IsEnabled}"
                                                    Click="ServerAction_Click"
                                                    Style="{StaticResource CardActionButtonStyle}">
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource AxSpace8}">
                                                        <FontIcon Glyph="{Binding Glyph}" FontSize="16" />
                                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TextBlock
                                    Text="服务端状态需要任务运行器，当前不可用。"
                                    Visibility="{Binding HasServerUpdate, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                    Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- 第二片：服务器管理（看门狗日志、日志与缓存清理、暂停监控）。 -->
                        <Border
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AxRadiusMedium}"
                            Padding="16">
                            <StackPanel Spacing="{StaticResource AxSpace12}">
                                <TextBlock Text="{Binding ServerManagementCardTitle}" Style="{StaticResource GroupTitleStyle}" />
                                <ItemsControl ItemsSource="{Binding ServerManagementActions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="200" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Margin="0,0,8,8"
                                                Click="ServerManagementAction_Click"
                                                Style="{StaticResource CardActionButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AxSpace8}">
                                                    <FontIcon Glyph="{Binding Glyph}" FontSize="16" />
                                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 第三片：PC 游戏本体推送（-> 野草云，清单 -> 阿里云）。 -->
                        <Border
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AxRadiusMedium}"
                            Padding="16">
                            <StackPanel Spacing="{StaticResource AxSpace12}">
                                <TextBlock Text="{Binding GamePublishCardTitle}" Style="{StaticResource GroupTitleStyle}" />
                                <TextBlock Text="{Binding PcPublishSummaryText}" Style="{StaticResource SubtleTextStyle}" />
                                <ItemsControl ItemsSource="{Binding GamePublishPcActions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="200" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Margin="0,0,8,8"
                                                IsEnabled="{Binding IsEnabled}"
                                                Tag="Windows"
                                                Click="ToolAction_Click"
                                                Style="{StaticResource CardActionButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AxSpace8}">
                                                    <FontIcon Glyph="{Binding IconGlyph}" FontSize="16" />
                                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl
                                    ItemsSource="{Binding GameMaintenanceActions}"
                                    Visibility="{Binding HasGameMaintenanceActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="200" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Margin="0,0,8,8"
                                                IsEnabled="{Binding IsEnabled}"
                                                Tag="Windows"
                                                Click="ToolAction_Click"
                                                Style="{StaticResource CardActionButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AxSpace8}">
                                                    <FontIcon Glyph="{Binding IconGlyph}" FontSize="16" />
                                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <!-- 第四片：安卓游戏本体推送；有安卓版本且发布开关打开才出现。 -->
                        <Border
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource AxRadiusMedium}"
                            Padding="16"
                            Visibility="{Binding HasAndroidGameBuild, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Spacing="{StaticResource AxSpace12}">
                                <TextBlock Text="{Binding GamePublishAndroidCardTitle}" Style="{StaticResource GroupTitleStyle}" />
                                <TextBlock Text="{Binding AndroidPublishSummaryText}" Style="{StaticResource SubtleTextStyle}" />
                                <ItemsControl ItemsSource="{Binding GamePublishAndroidActions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="200" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                Margin="0,0,8,8"
                                                IsEnabled="{Binding IsEnabled}"
                                                Tag="Android"
                                                Click="ToolAction_Click"
                                                Style="{StaticResource CardActionButtonStyle}">
                                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AxSpace8}">
                                                    <FontIcon Glyph="{Binding IconGlyph}" FontSize="16" />
                                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="FragmentPanel" Visibility="Collapsed" Style="{StaticResource PanelBorderStyle}" Padding="{StaticResource AxPanelPadding}">
                    <StackPanel x:Name="FragmentGenerationSection" Spacing="{StaticResource AxSpace12}">
                        <ComboBox
                            x:Name="FragmentGameSelector"
                            Header="游戏"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding FragmentGameOptions}"
                            SelectedItem="{Binding SelectedFragmentGame, Mode=TwoWay}"
                            DisplayMemberPath="DisplayName"
                            Visibility="{Binding HasFragmentGameSelection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock
                            Text="{Binding FragmentGenerationDescription}"
                            Style="{StaticResource SubtleTextStyle}"
                            TextWrapping="Wrap" />
                        <Grid ColumnSpacing="{StaticResource AxSpace10}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Header="源文件"
                                Text="{Binding FragmentGameDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="选择碎片打包产物目录" />
                            <Button
                                x:Name="FragmentSourceDirectoryBrowseButton"
                                Grid.Column="1"
                                Width="40"
                                Height="40"
                                Margin="0,24,0,0"
                                HorizontalAlignment="Stretch"
                                Click="FragmentPathBrowse_Click"
                                Tag="SourceDirectory"
                                Style="{StaticResource IconToolButtonStyle}"
                                ToolTipService.ToolTip="选择碎片源目录">
                                <FontIcon Glyph="&#xE8B7;" />
                            </Button>
                        </Grid>
                        <Grid ColumnSpacing="{StaticResource AxSpace10}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Header="碎片输出目录"
                                Text="{Binding FragmentOutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button
                                x:Name="FragmentOutputDirectoryBrowseButton"
                                Grid.Column="1"
                                Width="40"
                                Height="40"
                                Margin="0,24,0,0"
                                HorizontalAlignment="Stretch"
                                Click="FragmentPathBrowse_Click"
                                Tag="OutputDirectory"
                                Style="{StaticResource IconToolButtonStyle}"
                                ToolTipService.ToolTip="选择碎片输出目录">
                                <FontIcon Glyph="&#xE8B7;" />
                            </Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource AxSpace10}">
                            <Button
                                x:Name="GenerateFragmentsButton"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding CanGenerateFragments}"
                                Click="GenerateFragments_Click"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AxSpace8}">
                                    <SymbolIcon Symbol="Save" />
                                    <TextBlock Text="{Binding FragmentGenerationActionText}" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="PublishFragmentManifestButton"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding CanPublishFragmentManifest}"
                                Visibility="{Binding HasFragmentManifestPublishing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Click="PublishFragmentManifest_Click"
                                Style="{StaticResource PrimaryToolButtonStyle}"
                                ToolTipService.ToolTip="把 fragments.json 传到阿里云 www，并更新下载站 latest.json（碎片包走网盘/群，不上传）">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AxSpace8}">
                                    <SymbolIcon Symbol="Upload" />
                                    <TextBlock Text="发布碎片清单" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="PublishFragmentManifestToGitHubButton"
                                HorizontalAlignment="Left"
                                IsEnabled="{Binding CanPublishFragmentManifest}"
                                Visibility="{Binding HasFragmentGitHubFallback, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Click="PublishFragmentManifestToGitHub_Click"
                                Style="{StaticResource PrimaryToolButtonStyle}"
                                ToolTipService.ToolTip="只把 fragments.json 发到 GitHub Release 兜底，不连下载站，也不上传碎片 zip">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource AxSpace8}">
                                    <SymbolIcon Symbol="Upload" />
                                    <TextBlock Text="GitHub 兜底清单" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock
                            Text="{Binding FragmentLastResultText}"
                            Style="{StaticResource SubtleTextStyle}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border x:Name="StoragePanel" Visibility="Collapsed" Style="{StaticResource PanelBorderStyle}" Padding="{StaticResource AxPanelPadding}">
                    <StackPanel Spacing="{StaticResource AxSpace14}">
                        <StackPanel Spacing="{StaticResource AxSpace4}">
                            <TextBlock Text="存储清理" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="先扫描占用，再选择固定白名单中的缓存目录。" Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                        <Button
                            Content="扫描空间占用"
                            Height="40"
                            IsEnabled="{Binding IsStorageAvailable}"
                            HorizontalAlignment="Left"
                            Style="{StaticResource PrimaryToolButtonStyle}" />
                        <TextBlock Text="{Binding StorageAvailabilityText}" Style="{StaticResource SubtleTextStyle}" />
                    </StackPanel>
                </Border>

                <!-- 设置页（游戏专用）：上面是正规设置项，下面挂着临时的「功能散页」，
                     散页整理完就删，别把长期内容放进去。 -->
                <Border x:Name="SettingsPanel" Visibility="Collapsed" Style="{StaticResource PanelBorderStyle}" Padding="{StaticResource AxPanelPadding}">
                    <StackPanel Spacing="{StaticResource AxSpace14}">
                        <TextBlock Text="环境配置" Style="{StaticResource GroupTitleStyle}" />
                        <Grid ColumnSpacing="{StaticResource AxSpace12}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="{StaticResource AxSpace2}">
                                <TextBlock Text="是否拥有安卓启动器" />
                                <TextBlock
                                    Text="关掉后安卓项目不再参与开发环境检查，也不需要填路径。"
                                    Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsOn="{Binding HasAndroidLauncher, Mode=TwoWay}" />
                        </Grid>

                        <StackPanel Spacing="{StaticResource AxSpace10}">
                            <Grid ColumnSpacing="{StaticResource AxSpace10}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Header="本体路径"
                                    PlaceholderText="选择或输入本体项目目录"
                                    Text="{Binding ClientProjectPath, Mode=TwoWay}" />
                                <Button
                                    Grid.Column="1"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Bottom"
                                    Tag="client"
                                    Click="ProjectPathBrowse_Click"
                                    Style="{StaticResource IconToolButtonStyle}"
                                    ToolTipService.ToolTip="选择本体项目目录">
                                    <FontIcon Glyph="&#xE8B7;" />
                                </Button>
                            </Grid>
                            <Grid
                                ColumnSpacing="{StaticResource AxSpace10}"
                                Visibility="{Binding HasAndroidLauncher, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Header="安卓启动器路径"
                                    PlaceholderText="选择或输入安卓启动器目录"
                                    Text="{Binding AndroidLauncherPath, Mode=TwoWay}" />
                                <Button
                                    Grid.Column="1"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Bottom"
                                    Tag="android"
                                    Click="ProjectPathBrowse_Click"
                                    Style="{StaticResource IconToolButtonStyle}"
                                    ToolTipService.ToolTip="选择安卓启动器目录">
                                    <FontIcon Glyph="&#xE8B7;" />
                                </Button>
                            </Grid>
                            <Grid ColumnSpacing="{StaticResource AxSpace10}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Header="本机服务端仓库"
                                    PlaceholderText="三个游戏的裸仓库都放在这个目录下"
                                    Text="{Binding ServerLocalRepoRoot, Mode=TwoWay}" />
                                <Button
                                    Grid.Column="1"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Bottom"
                                    Tag="server-root"
                                    Click="ProjectPathBrowse_Click"
                                    Style="{StaticResource IconToolButtonStyle}"
                                    ToolTipService.ToolTip="选择本机服务端仓库目录">
                                    <FontIcon Glyph="&#xE8B7;" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- 游戏打包与上传：安卓游戏与安卓启动器是两件事，这里只管游戏包。 -->
                        <TextBlock Text="游戏打包与上传" Style="{StaticResource GroupTitleStyle}" Margin="0,8,0,0" />

                        <Grid ColumnSpacing="{StaticResource AxSpace12}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="{StaticResource AxSpace2}">
                                <TextBlock Text="是否有安卓游戏版本" />
                                <TextBlock
                                    Text="只影响游戏本体；安卓启动器是另一套设置。"
                                    Style="{StaticResource SubtleTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsOn="{Binding HasAndroidGameBuild, Mode=TwoWay}" />
                        </Grid>

                        <StackPanel Spacing="{StaticResource AxSpace10}">
                            <Grid ColumnSpacing="{StaticResource AxSpace10}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Header="PC 游戏包目录"
                                    PlaceholderText="打包产物目录（发布到下载站用）"
                                    Text="{Binding PcGamePackageRoot, Mode=TwoWay}" />
                                <Button
                                    Grid.Column="1"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Bottom"
                                    Tag="game-pc-package"
                                    Click="ProjectPathBrowse_Click"
                                    Style="{StaticResource IconToolButtonStyle}"
                                    ToolTipService.ToolTip="选择 PC 游戏包目录">
                                    <FontIcon Glyph="&#xE8B7;" />
                                </Button>
                            </Grid>
                            <Grid
                                ColumnSpacing="{StaticResource AxSpace10}"
                                Visibility="{Binding HasAndroidGameBuild, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Header="安卓游戏包目录"
                                    PlaceholderText="安卓打包产物目录"
                                    Text="{Binding AndroidGamePackageRoot, Mode=TwoWay}" />
                                <Button
                                    Grid.Column="1"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Bottom"
                                    Tag="game-android-package"
                                    Click="ProjectPathBrowse_Click"
                                    Style="{StaticResource IconToolButtonStyle}"
                                    ToolTipService.ToolTip="选择安卓游戏包目录">
                                    <FontIcon Glyph="&#xE8B7;" />
                                </Button>
                            </Grid>
                        </StackPanel>

                        <Grid ColumnSpacing="{StaticResource AxSpace12}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="上传到野草云（下载站）" VerticalAlignment="Center" />
                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsOn="{Binding PublishToDownloadSite, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnSpacing="{StaticResource AxSpace12}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="上传到 GitHub Release" VerticalAlignment="Center" />
                            <ToggleSwitch
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                IsOn="{Binding PublishToGitHub, Mode=TwoWay}" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <StackPanel Spacing="{StaticResource AxSpace4}">
                            <TextBlock Text="功能散页" Style="{StaticResource GroupTitleStyle}" />

                            <TextBlock
                                Text="临时区：暂时没有正式位置的功能，以及还没抽出来复用的逻辑。整理完这块就删。"
                                Style="{StaticResource SubtleTextStyle}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding GameScratchItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="12"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource AxRadiusMedium}">
                                        <Grid ColumnSpacing="{StaticResource AxSpace12}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="{StaticResource AxSpace2}">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource SubtleTextStyle}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{Binding Status}"
                                                FontSize="{StaticResource AxFontCaption}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
