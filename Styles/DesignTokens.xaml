<?xml version="1.0" encoding="utf-8"?>
<!--
    设计令牌：所有间距、字号、圆角、内边距的唯一来源。

    规矩：
    1. 只放"数值"，不放控件模板；控件样式仍在 ToolboxStyles.xaml。
    2. 新增令牌只在现有取值不够用时才加，不要为一次性排版发明新数值。
    3. XAML 里凡是重复出现的间距/字号，一律引用这里，不再写字面量。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 间距阶梯：对应 StackPanel.Spacing / Grid.ColumnSpacing / Grid.RowSpacing -->
    <x:Double x:Key="AxSpace2">2</x:Double>
    <x:Double x:Key="AxSpace4">4</x:Double>
    <x:Double x:Key="AxSpace6">6</x:Double>
    <x:Double x:Key="AxSpace8">8</x:Double>
    <x:Double x:Key="AxSpace10">10</x:Double>
    <x:Double x:Key="AxSpace12">12</x:Double>
    <x:Double x:Key="AxSpace14">14</x:Double>
    <x:Double x:Key="AxSpace16">16</x:Double>
    <x:Double x:Key="AxSpace20">20</x:Double>
    <x:Double x:Key="AxSpace22">22</x:Double>

    <!-- 字号阶梯 -->
    <x:Double x:Key="AxFontPageTitle">28</x:Double>
    <x:Double x:Key="AxFontCardTitle">20</x:Double>
    <x:Double x:Key="AxFontSectionTitle">16</x:Double>
    <x:Double x:Key="AxFontCaption">12</x:Double>

    <!-- 圆角阶梯 -->
    <CornerRadius x:Key="AxRadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="AxRadiusMedium">6</CornerRadius>
    <CornerRadius x:Key="AxRadiusLarge">8</CornerRadius>

    <!-- 内边距 -->
    <Thickness x:Key="AxPagePadding">0,0,20,0</Thickness>
    <Thickness x:Key="AxPanelPadding">18</Thickness>
    <Thickness x:Key="AxShellPadding">20</Thickness>
</ResourceDictionary>
