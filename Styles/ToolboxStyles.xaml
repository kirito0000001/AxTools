<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="GlobalProgressHostBackgroundBrush" Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="GlobalProgressHostBorderBrush" Color="#33000000" />
            <SolidColorBrush x:Key="GlobalProgressPrimaryTextBrush" Color="#202020" />
            <SolidColorBrush x:Key="GlobalProgressSecondaryTextBrush" Color="#99000000" />
            <SolidColorBrush x:Key="LogDefaultForegroundBrush" Color="#FF1F1F1F" />
            <SolidColorBrush x:Key="LogDefaultBackgroundBrush" Color="#FFF2F2F2" />
            <SolidColorBrush x:Key="LogDefaultBorderBrush" Color="#FF7A7A7A" />
            <SolidColorBrush x:Key="LogUserForegroundBrush" Color="#FF176B3A" />
            <SolidColorBrush x:Key="LogUserBackgroundBrush" Color="#FFE6F4EA" />
            <SolidColorBrush x:Key="LogUserBorderBrush" Color="#FF4D9A68" />
            <SolidColorBrush x:Key="LogWarningForegroundBrush" Color="#FF8A5200" />
            <SolidColorBrush x:Key="LogWarningBackgroundBrush" Color="#FFFFF3CD" />
            <SolidColorBrush x:Key="LogWarningBorderBrush" Color="#FFB77900" />
            <SolidColorBrush x:Key="LogErrorForegroundBrush" Color="#FFA61B1B" />
            <SolidColorBrush x:Key="LogErrorBackgroundBrush" Color="#FFFDE2E2" />
            <SolidColorBrush x:Key="LogErrorBorderBrush" Color="#FFB42318" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="GlobalProgressHostBackgroundBrush" Color="#F0000000" />
            <SolidColorBrush x:Key="GlobalProgressHostBorderBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="GlobalProgressPrimaryTextBrush" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="GlobalProgressSecondaryTextBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="LogDefaultForegroundBrush" Color="#FFE1E1E1" />
            <SolidColorBrush x:Key="LogDefaultBackgroundBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="LogDefaultBorderBrush" Color="#41FFFFFF" />
            <SolidColorBrush x:Key="LogUserForegroundBrush" Color="#FFE1E1E1" />
            <SolidColorBrush x:Key="LogUserBackgroundBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="LogUserBorderBrush" Color="#41FFFFFF" />
            <SolidColorBrush x:Key="LogWarningForegroundBrush" Color="#FFFFD700" />
            <SolidColorBrush x:Key="LogWarningBackgroundBrush" Color="#2AA06E00" />
            <SolidColorBrush x:Key="LogWarningBorderBrush" Color="#78DCAA28" />
            <SolidColorBrush x:Key="LogErrorForegroundBrush" Color="#FFFF4500" />
            <SolidColorBrush x:Key="LogErrorBackgroundBrush" Color="#34821818" />
            <SolidColorBrush x:Key="LogErrorBorderBrush" Color="#96E65046" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="GlobalProgressAccentBrush" Color="#008F8D" />
    <SolidColorBrush x:Key="GlobalProgressTrackBrush" Color="#1A008F8D" />

    <Style x:Key="LogDefaultTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource LogDefaultForegroundBrush}" />
    </Style>
    <Style x:Key="LogUserTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource LogUserForegroundBrush}" />
    </Style>
    <Style x:Key="LogWarningTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource LogWarningForegroundBrush}" />
    </Style>
    <Style x:Key="LogErrorTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource LogErrorForegroundBrush}" />
    </Style>

    <Style x:Key="LogDefaultBlockStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LogDefaultBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LogDefaultBorderBrush}" />
    </Style>
    <Style x:Key="LogUserBlockStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LogUserBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LogUserBorderBrush}" />
    </Style>
    <Style x:Key="LogWarningBlockStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LogWarningBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LogWarningBorderBrush}" />
    </Style>
    <Style x:Key="LogErrorBlockStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LogErrorBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource LogErrorBorderBrush}" />
    </Style>

    <Style x:Key="PanelBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SubtleTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="IconToolButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="PrimaryToolButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style x:Key="ToolbarBorderStyle" TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
        <Setter Property="Padding" Value="12" />
    </Style>

    <Style TargetType="Expander">
        <Setter Property="IsExpanded" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
</ResourceDictionary>
